# Compiled plugin binaries, object files, intermediates -- 1.4GB, fully
# reproducible from Source/ + the .jucer via Xcode.
EQ/Builds/*/build/

# Xcode per-user state (breakpoints, window layout) -- machine-specific,
# not part of the project.
**/xcuserdata/
**/*.xcuserstate

# Regenerated by Projucer --resave from EQ.jucer + the module set; not
# hand-edited, so it's boilerplate rather than source.
EQ/JuceLibraryCode/

# macOS
.DS_Store
