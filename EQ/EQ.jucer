<?xml version="1.0" encoding="UTF-8"?>

<JUCERPROJECT id="eqPlg1" name="EQ" projectType="audioplug" useAppConfig="0"
              addUsingNamespaceToJuceHeader="0" jucerFormatVersion="1" companyName="AudioFlower"
              companyWebsite="https://audioflower.art" companyEmail="luke@audioflower.art"
              version="1.0.0" pluginManufacturerCode="Lgld" pluginCode="Peq1"
              pluginDesc="Six-band parametric EQ with live spectrum analysis">
  <MAINGROUP id="eqMain" name="EQ">
    <GROUP id="{7F3A9C21-4B8E-D6A0-1F52-9E3C7A0B4D18}" name="Source">
      <FILE id="eqPPc0" name="PluginProcessor.cpp" compile="1" resource="0"
